/// Trading calendar 2017 (store-local dates), marked as the date table.
table Date
	dataCategory: Time
	lineageTag: d2a2d401-0098-4813-b3e2-a71f8b9123c4

	column date_key
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 266e64e0-d23a-484c-804c-c70b202b3c70
		sourceColumn: date_key

	column retail_week
		dataType: int64
		lineageTag: 6a6e274f-2b16-46e3-8a2d-53a5394d3805
		summarizeBy: none
		sourceColumn: retail_week

	column week_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: afe2cab2-48ea-413b-a708-969222c51583
		sourceColumn: week_start

	column month_number
		dataType: int64
		isHidden
		lineageTag: ef244ef5-6dfe-482f-a095-1d0664d4817c
		summarizeBy: none
		sourceColumn: month_number

	column quarter_number
		dataType: int64
		isHidden
		lineageTag: 4c697cea-1a40-47b0-8b5a-4e2a79720115
		summarizeBy: none
		sourceColumn: quarter_number

	column day_of_week
		dataType: int64
		isHidden
		lineageTag: 0b973444-641e-4fb6-961f-01688567b129
		summarizeBy: none
		sourceColumn: day_of_week

	column holiday_name
		dataType: string
		lineageTag: b16d8f57-31a2-40cd-b094-d1ba00a48fca
		sourceColumn: holiday_name

	column month_name
		dataType: string
		lineageTag: 6b44c8cf-5eb1-4b82-ae8e-6ed438577bc7
		sourceColumn: month_name
		sortByColumn: month_number

	column quarter_name
		dataType: string
		lineageTag: b6ccf8c3-5c4d-4999-869d-6e78d4fc55b6
		sourceColumn: quarter_name
		sortByColumn: quarter_number

	column day_name
		dataType: string
		lineageTag: e0569504-aad0-4af4-9b84-ac40ebea4b87
		sourceColumn: day_name
		sortByColumn: day_of_week

	partition Date = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dim_date.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"date_key", type date}, {"retail_week", Int64.Type}, {"week_start", type date}, {"month_number", Int64.Type}, {"month_name", type text}, {"quarter_number", Int64.Type}, {"quarter_name", type text}, {"day_of_week", Int64.Type}, {"day_name", type text}, {"holiday_name", type text}})
				in
				    Typed

