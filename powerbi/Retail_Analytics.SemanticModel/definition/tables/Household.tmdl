		sourceColumn: m_score

	partition Household = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dim_household.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"household_id", type text}, {"has_demographics", type logical}, {"age", type text}, {"age_order", Int64.Type}, {"income_band", type text}, {"household_comp", type text}, {"household_size", type text}, {"campaigns_received", Int64.Type}, {"rfm_segment", type text}, {"deal_segment", type text}, {"recency_days", Int64.Type}, {"r_score", Int64.Type}, {"f_score", Int64.Type}, {"m_score", Int64.Type}})
				in
