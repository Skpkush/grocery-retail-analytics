/// One row per coupon redemption.
table 'Coupon Redemptions'
	lineageTag: a8a0fdac-5e38-4f75-9150-23c3f6f34bf5

	column household_id
		dataType: string
		isHidden
		lineageTag: 4b415079-8c67-43d1-93fa-372c1b2381e5
		sourceColumn: household_id

	column coupon_upc
		dataType: string
		isHidden
		lineageTag: 968aef3b-33ae-42a8-8a89-494c6f3ad576
		sourceColumn: coupon_upc

	column campaign_id
		dataType: string
		lineageTag: b124b2fa-6444-43c1-8236-8b0e2d2816b5
		sourceColumn: campaign_id

	column campaign_type
		dataType: string
		lineageTag: 58b799c2-d8a1-4c27-bb21-fce2abd0ea90
		sourceColumn: campaign_type

	column redemption_date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: f2900470-fd0e-4af7-8809-df9eadea19e2
		summarizeBy: none
		sourceColumn: redemption_date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column redemption_id
		dataType: int64
		isHidden
		lineageTag: e6525459-a25a-4b05-9f24-8f9a561b7782
		summarizeBy: none
		sourceColumn: redemption_id

	/// TRUE when the redemption has a full 56-day look-back (on/after 26 Feb 2017).
	column is_scored
		dataType: boolean
		lineageTag: 8363e358-2eef-4e53-ab51-ee0690511f80
		sourceColumn: is_scored

	/// Household bought a product covered by the coupon in the 56 days before redeeming.
	column is_habitual
		dataType: boolean
		lineageTag: 1fb45a5b-5214-4262-acfd-58e9024b6c9b
		sourceColumn: is_habitual

	partition 'Coupon Redemptions' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fct_coupon_redemptions.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"redemption_id", Int64.Type}, {"household_id", type text}, {"coupon_upc", type text}, {"campaign_id", type text}, {"campaign_type", type text}, {"redemption_date", type date}, {"is_scored", type logical}, {"is_habitual", type logical}})
				in
				    Typed

