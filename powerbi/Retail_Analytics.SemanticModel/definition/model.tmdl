model Retail_Analytics
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["Sales","Product","Household","Date","Coupon Redemptions","Campaign Targets","DataFolder"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table Sales
ref table Product
ref table Household
ref table Date
ref table 'Coupon Redemptions'
ref table 'Campaign Targets'

