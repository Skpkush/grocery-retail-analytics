{
  "name": "Grocery Retail Analytics",
  "dataColors": [
    "#0F766E",
    "#D97706",
    "#2563EB",
    "#7C3AED",
    "#DB2777",
    "#65A30D",
    "#0891B2",
    "#94A3B8"
  ],
  "foreground": "#0F172A",
  "foregroundNeutralSecondary": "#475569",
  "foregroundNeutralTertiary": "#94A3B8",
  "background": "#FFFFFF",
  "backgroundLight": "#F1F5F9",
  "backgroundNeutral": "#E2E8F0",
  "tableAccent": "#0F766E",
  "good": "#15803D",
  "neutral": "#64748B",
  "bad": "#B91C1C",
  "maximum": "#0F766E",
  "center": "#99F6E4",
  "minimum": "#F0FDFA",
  "null": "#CBD5E1",
  "hyperlink": "#0F766E",
  "visitedHyperlink": "#115E59",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#0F172A" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0F172A" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#0F172A" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#475569" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": true }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#0F172A" } },
          "fontSize": 12,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F8FAFC" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F8FAFC" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#0F766E" } }, "fontSize": 26, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#475569" } }, "fontSize": 10 }],
        "wordWrap": [{ "show": true }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "items": [{ "fontColor": { "solid": { "color": "#0F172A" } }, "textSize": 10 }],
        "header": [{ "fontColor": { "solid": { "color": "#475569" } }, "textSize": 10 }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } },
          "gridVertical": false,
          "rowPadding": 4
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#0F172A" } },
          "backColor": { "solid": { "color": "#F1F5F9" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Semibold"
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#0F172A" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#0F172A" } },
          "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
          "fontSize": 10
        }],
        "total": [{ "fontFamily": "Segoe UI Semibold", "backColor": { "solid": { "color": "#F1F5F9" } } }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#0F766E" } } }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#475569" } }, "fontSize": 9 }],
        "valueAxis": [{ "show": false, "gridlineShow": false }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#0F172A" } }, "fontSize": 10, "showAxisTitle": false }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#0F766E" } } }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#475569" } }, "fontSize": 9 }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#E2E8F0" } }, "showAxisTitle": false }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#0F172A" } }, "fontSize": 10, "showAxisTitle": false }]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#0F766E" } } }],
        "lineStyles": [{ "strokeWidth": 3 }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#E2E8F0" } }, "showAxisTitle": false }],
        "categoryAxis": [{ "showAxisTitle": false }]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3 }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#E2E8F0" } }, "showAxisTitle": false }],
        "categoryAxis": [{ "showAxisTitle": true }],
        "legend": [{ "show": true, "position": "Top" }]
      }
    }
  }
}
