    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "1. A small group of households drives most of the sales",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#0F766E",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The top 10% of households generate 34.2% of merchandise sales. RFM 'Champions' (513 households, 21% of shoppers) generate 45.7%. 318 'At risk' households (frequent shoppers, no visit for about 26 days) still hold 13.4% of annual sales.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Action: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Make retention the priority: protect Champions and run win-back offers for At-risk households before they lapse.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Caveat: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "One year of data from a loyalty panel. RFM describes past behaviour and does not predict who will leave. Segment boundaries are quintiles, not business thresholds.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#475569",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Confidence: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "High",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#475569",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
