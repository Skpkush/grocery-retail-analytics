  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "3. The data cannot show whether campaigns increase spending",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#0F766E",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Difference-in-differences against the 910 never-targeted households fails its placebo test for 3 of 3 campaign types. Targeted households were already spending less than controls before launch, by up to $5.26 per household per week. Redemption rates differ by type (Type A 16.6%, Type B 6.5%), but redemption is not the same as extra spend.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Action: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Hold out a random 10% of every campaign's target list, so future campaigns have a valid comparison group and ROI can be measured.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Caveat: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "This does not say campaigns fail. It says the current targeting makes their effect impossible to separate from the households' existing trend.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#475569",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Confidence: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Cannot conclude",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#475569",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
