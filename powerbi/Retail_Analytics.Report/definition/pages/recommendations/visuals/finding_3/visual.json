  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "4. A display and a mailer together are linked to much higher sales than either alone",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#0F766E",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Against the same product in the same store in unpromoted weeks, weekly sales were 131% higher with a mailer only, 129% higher with a display only, and 225% higher with both (95% CI 219-230%, 123,761 product x store pairs).",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Action: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "When an item is featured in the mailer, give it an in-store display too, and run a controlled store test to confirm the combined effect.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Caveat: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Promotions are not randomly assigned. Retailers promote items in season or already trending, so these figures are an upper bound, not a causal lift. Sales are the panel households' only.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#475569",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Confidence: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Moderate",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#475569",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
