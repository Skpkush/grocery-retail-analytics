    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "2. About half of coupon redemptions go to households already buying the product",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#0F766E",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "50.6% of 2,046 scored redemptions (95% CI 48.5-52.8%) came from households that bought a product covered by the coupon in the previous 56 days; 54.5% for Type A campaigns.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Action: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Leave a product's recent buyers out of its coupon mailings, and test the change with a holdout before rolling it out.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Caveat: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "A habitual buyer may still buy more because of the coupon, so this does not measure lost incremental volume. It is a proxy for subsidised repeat purchases.",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#475569",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Confidence: ",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#0F172A",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Moderate",
                    "textStyle": {
                      "fontSize": "8.5pt",
                      "color": "#475569",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
